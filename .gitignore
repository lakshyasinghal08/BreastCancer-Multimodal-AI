logs/
*.log
runs/
wandb/
tensorboard/
*.tfevents.*
lightning_logs/
.coverage
htmlcov/
.pytest_cache/

# --- Cache, Temporary Directories & Intermediate Scratch Files ---
cache/
.cache/
scratch/
mpl_config/
tmp/
temp/
*.tmp
*.bak

