    "numpy_seed": 42,
    "torch_cpu_seed": 42,
    "torch_cuda_seed": 42
  },
  "core_libraries": {
    "numpy": "1.26.2",
    "scipy": "1.11.4",
    "pandas": "2.1.4",
    "scikit_learn": "1.3.2",
    "matplotlib": "3.8.2",
    "seaborn": "0.13.0",
    "onnxruntime": "1.16.3",
    "pydicom": "2.4.4",
    "simpleitk": "2.3.1"
  }
}